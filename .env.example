# ---------------------------------------------------------------------------
# Litmus — environment template
# ---------------------------------------------------------------------------
#
#   cp .env.example .env      then fill in the values below.
#
# .env is gitignored and must stay that way. This file is committed, so it
# carries placeholders only — never paste a real key into it.
#
# On Render and Vercel there is no .env at all: set these in the dashboard.
# Real environment variables always take priority over this file.


# --- Signing secrets (required in production) ------------------------------
#
# Each of these has a working development default that is public in this
# repository, which is exactly why they must be set once this is deployed.
#
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# LITMUS_REPORT_SECRET is the one to get right. It signs the verification code
# printed on every PDF record. Left at its default, anyone holding a copy of
# this repository can forge that code, which defeats the entire point of it.

LITMUS_TRUSTLINE_SECRET=
LITMUS_LIVECHALLENGE_SECRET=
LITMUS_REPORT_SECRET=
LITMUS_CONSORTIUM_SALT=


# --- CORS ------------------------------------------------------------------
#
# Comma-separated allowlist of origins allowed to call this API. Needed only
# for the split deployment, where the console is hosted separately:
#
#   LITMUS_ALLOWED_ORIGINS=https://your-app.vercel.app
#
# Leave blank for local development and for the same-origin deployment, where
# the API serves the console itself at /console.

LITMUS_ALLOWED_ORIGINS=


# --- Email delivery (optional everywhere) ----------------------------------
#
# Without these, records are still generated and downloadable. The response
# reports sent:false with a reason — it never claims a delivery it did not
# make.
#
# The sender must be a Verified Sender in SMTP2GO first, or every send is
# rejected. Dashboard: Sending -> Verified Senders -> Add.

LITMUS_SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LITMUS_SMTP2GO_SENDER=you@a-verified-address

# Plain SMTP fallback. The HTTP API above is preferred for deployment because
# it is an ordinary HTTPS request, so it survives the outbound-port blocking
# that silently breaks SMTP on most managed hosts. Gmail needs an App
# Password, not your account password.

LITMUS_SMTP_HOST=
LITMUS_SMTP_PORT=587
LITMUS_SMTP_USER=
LITMUS_SMTP_PASSWORD=
LITMUS_SMTP_FROM=


# --- DoT Financial Fraud Risk Indicator (optional) -------------------------
#
# Live FRI access needs an onboarded Digital Intelligence Platform account; it
# is not a public API. Left unset, Litmus runs a deterministic local heuristic
# and flags every result as simulated, in the console and in the response.

LITMUS_FRI_BASE_URL=
LITMUS_FRI_API_KEY=
LITMUS_FRI_TIMEOUT=2.5


# --- Behaviour flags -------------------------------------------------------
#
# LITMUS_REQUIRE_SPEECH=0 stops LiveChallenge requiring audible speech in a
# response. Leave it on: with it off, staying silent passes the round, and a
# check that does not care whether you complied is not a check.

LITMUS_REQUIRE_SPEECH=1
LITMUS_CONSORTIUM_MEMBER=TVS Credit
